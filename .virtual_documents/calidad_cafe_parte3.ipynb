paises = ["Mexico", "Brazil", "Colombia", "Guatemala"]
columnas_altitud = ["altitude_mean_meters",
                    "altitude_low_meters",
                    "altitude_high_meters"]

df_long = (
    datos
    .query("country_of_origin in @paises and expiration_year in [2016, 2017]")
    .assign(fecha_exp=lambda d: pd.to_datetime(
        pd.DataFrame({"year":  d["expiration_year"],
                      "month": d["expiration_month"],
                      "day":   1})
    ))
    .loc[:, ["fecha_exp"] + columnas_altitud]
    .dropna()
    .melt(id_vars="fecha_exp", var_name="tipo_altitud", value_name="altitud")
)

sns.set_theme(style="whitegrid", context="notebook")
fig, ax = plt.subplots(figsize=(11, 5.5))

sns.lineplot(
    data=df_long,
    x="fecha_exp", y="altitud", hue="tipo_altitud",
    estimator="mean",
    errorbar=None,
    linewidth=1.2,
    ax=ax
)

ax.xaxis.set_major_locator(mdates.MonthLocator(interval=2))
ax.xaxis.set_major_formatter(mdates.DateFormatter("%b %Y"))
ax.set(xlabel="Fecha de expiración", ylabel="Altitud (metros)",
       title="México, Brasil, Colombia y Guatemala")
ax.legend(title="Tipo de altitud", loc="center left",
          bbox_to_anchor=(1.02, 0.5), frameon=False)
plt.setp(ax.get_xticklabels(), rotation=45, ha="right")
plt.tight_layout()
plt.show()






